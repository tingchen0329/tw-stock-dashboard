{
  "_comment": "FinMind 個股資料集規格。Python 抓取腳本 (scripts/fetch_data.py) 與網頁 (assets/js/data.js) 共用這份檔案，確保兩邊欄位一致。days = 往回抓幾天；fields = 保留的欄位（其他欄位丟掉以縮小檔案）；wave = 1 先載入並立即顯示，2 背景補齊。",
  "price":   { "dataset": "TaiwanStockPrice", "days": 1100, "wave": 1,
               "fields": ["date", "open", "max", "min", "close", "Trading_Volume"] },
  "per":     { "dataset": "TaiwanStockPER", "days": 1100, "wave": 1,
               "fields": ["date", "PER", "PBR", "dividend_yield"] },
  "revenue": { "dataset": "TaiwanStockMonthRevenue", "days": 800, "wave": 1,
               "fields": ["revenue_year", "revenue_month", "revenue"] },
  "inst":    { "dataset": "TaiwanStockInstitutionalInvestorsBuySell", "days": 60, "wave": 1,
               "fields": ["date", "name", "buy", "sell"] },
  "margin":  { "dataset": "TaiwanStockMarginPurchaseShortSale", "days": 60, "wave": 2,
               "fields": ["date", "MarginPurchaseTodayBalance", "ShortSaleTodayBalance"] },
  "holding": { "dataset": "TaiwanStockShareholding", "days": 120, "wave": 2,
               "fields": ["date", "ForeignInvestmentSharesRatio"] },
  "income":  { "dataset": "TaiwanStockFinancialStatements", "days": 800, "wave": 2,
               "fields": ["date", "type", "value", "origin_name"],
               "keep_types": ["Revenue", "GrossProfit", "OperatingIncome", "IncomeAfterTaxes",
                              "IncomeAfterTax", "NetIncome", "EquityAttributableToOwnersOfParent", "EPS"],
               "keep_origin": ["每股盈餘", "營業收入", "營業毛利", "營業利益", "本期淨利", "本期稅後淨利"] },
  "balance": { "dataset": "TaiwanStockBalanceSheet", "days": 800, "wave": 2,
               "fields": ["date", "type", "value", "origin_name"],
               "keep_types": ["TotalAssets", "Liabilities", "Equity", "CurrentAssets",
                              "CurrentLiabilities", "EquityAttributableToOwnersOfParent"],
               "keep_origin": ["資產總額", "資產總計", "負債總額", "負債總計", "權益總額", "權益總計",
                               "流動資產合計", "流動負債合計"] }
}
